#include <windows.h>
#include "version.h"

1 ICON "../../build/icon.ico"
1 24 "host.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AIO_VERSION_COMMA
 PRODUCTVERSION AIO_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SunnySlopes & more"
            VALUE "FileDescription", "All-In-One Finder"
            VALUE "FileVersion", AIO_VERSION_STRING
            VALUE "InternalName", "aio-host"
            VALUE "LegalCopyright", "GPL-3.0-only"
            VALUE "OriginalFilename", "All-In-One Finder.exe"
            VALUE "ProductName", "All-In-One Finder"
            VALUE "ProductVersion", AIO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
